---
import { CircleAlertIcon, DownloadIcon } from '@lucide/vue'
import { Badge } from '@/components/ui/badge'
import CommandBlock from '@/components/site/CommandBlock.vue'
import GitHubMark from '@/components/site/GitHubMark.vue'
import LinkButton from '@/components/site/LinkButton.vue'
import { DOWNLOAD_CHANNELS, INSTALL_COMMAND, SITE } from '@/lib/site'
---

<section id="download" class="border-border/70 bg-muted/25 border-y" aria-labelledby="download-title">
  <div class="container-page py-14 sm:py-18 lg:py-22">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">下载</p>
      <h2 id="download-title" class="section-title">立即下载 {SITE.name}</h2>
      <p class="section-desc">
        下载 DMG，先去隔离标记，再拖进「应用程序」。装之前，建议先到 GitHub Releases 对一下版本号。
      </p>
    </div>

    <div class="reveal mt-8 grid gap-3 md:grid-cols-2">
      {
        DOWNLOAD_CHANNELS.map((channel) => (
          <div
            class:list={[
              'card-surface flex flex-col p-5',
              channel.variant === 'default' && 'ring-2 ring-primary/30',
            ]}
          >
            <Badge variant={channel.variant === 'default' ? 'default' : 'outline'} class="h-6 px-2.5">
              {channel.tag}
            </Badge>
            <h3 class="mt-3 text-lg font-semibold tracking-tight">{channel.title}</h3>
            <p class="text-muted-foreground mt-1.5 text-sm leading-6">{channel.description}</p>
            <div class="mt-4 flex flex-col gap-2">
              {channel.options.map((option) => (
                <LinkButton href={option.href} external variant={channel.variant} class="w-full">
                  {channel.icon === 'github' ? <GitHubMark size={16} /> : <DownloadIcon />}
                  {option.label}
                </LinkButton>
              ))}
            </div>
            <p class="text-muted-foreground mt-2 text-xs">{channel.note}</p>
          </div>
        ))
      }
    </div>

    <div class="reveal card-surface mt-4 p-5 sm:p-6">
      <h3 class="text-base font-semibold">安装与首次运行</h3>

      <div class="mt-4 grid gap-5 lg:grid-cols-2">
        <p class="text-muted-foreground flex gap-2.5 text-sm leading-6">
          <CircleAlertIcon class="text-primary mt-0.5 size-4 shrink-0" />
          <span>
            应用使用临时签名（ad-hoc），没有走 Apple 公证。macOS Sequoia 及之后会在挂载 DMG 前就拦下文件，弹窗里也没有「仍要打开」。
            先去掉 DMG 的隔离标记，再双击挂载，把窗口里的「檐下」拖进
            <code class="bg-muted text-foreground rounded-md px-1.5 py-0.5 font-mono text-xs">/Applications</code>
            就能直接启动。文件本身没坏。
          </span>
        </p>

        <div>
          <p class="text-muted-foreground text-sm leading-6">
            只需执行下面这一条命令处理下载的 DMG；DMG 去隔离后，装好的 App 不再带隔离属性，不需要再对
            <code class="bg-muted text-foreground rounded-md px-1.5 py-0.5 font-mono text-xs">/Applications/檐下.app</code>
            执行一次。DMG 不在下载目录时换成实际路径。应用里的「应用去隔离」也接受直接拖拽修复。
          </p>
          <div class="mt-3">
            <CommandBlock client:visible code={INSTALL_COMMAND} label="移除 Gatekeeper 隔离标记" />
          </div>
        </div>
      </div>
    </div>

    <p class="text-muted-foreground mt-5 text-xs">
      系统要求：{SITE.osRequirement} · 适用芯片：{SITE.archRequirement}
    </p>
  </div>
</section>
