---
import { ExternalLinkIcon, HeartIcon } from '@lucide/vue'
import LinkButton from '@/components/site/LinkButton.vue'
import RewardCard from '@/components/site/RewardCard.vue'
import SiteAvatar from '@/components/site/SiteAvatar.vue'
import AuthorNote from '@/content/about-author.mdx'
import { ACKNOWLEDGEMENTS, AUTHOR, SITE } from '@/lib/site'
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container-page">
    <div class="reveal grid gap-3 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.5fr)] lg:gap-10">
      <div class="card-surface flex flex-col p-6">
        <p class="eyebrow">关于作者</p>
        <h2 id="about-title" class="section-title">作者与项目</h2>

        <div class="mt-5 flex items-center gap-3">
          <SiteAvatar src={AUTHOR.avatar} alt={`${AUTHOR.name} 的头像`} class="size-11" />
          <div class="min-w-0">
            <p class="text-sm font-medium">{AUTHOR.name}</p>
            <p class="text-muted-foreground truncate text-xs">{AUTHOR.repoLabel}</p>
          </div>
        </div>

        <p class="text-muted-foreground mt-4 text-sm leading-6">{AUTHOR.intro}</p>

        <div class="border-border mt-auto flex flex-wrap gap-2 border-t pt-4">
          {
            AUTHOR.links.map((link) => (
              <LinkButton href={link.href} external variant="outline" size="sm">
                {link.label}
                <ExternalLinkIcon data-icon="inline-end" />
              </LinkButton>
            ))
          }
        </div>
      </div>

      <div class="prose-calm card-surface p-6">
        <AuthorNote />
      </div>
    </div>

    <div class="reveal mt-3">
      <RewardCard client:visible />
    </div>

    <div class="reveal border-border mt-6 flex flex-wrap items-center gap-x-2 gap-y-2 border-t pt-6">
      <span class="text-muted-foreground inline-flex items-center gap-1.5 text-xs">
        <HeartIcon class="text-primary size-3.5" />
        致谢
      </span>
      {
        ACKNOWLEDGEMENTS.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="border-border text-muted-foreground hover:bg-muted hover:text-foreground rounded-full border px-2.5 py-1 text-xs transition-colors"
          >
            {item.name}
          </a>
        ))
      }
      <span class="text-muted-foreground ml-auto text-xs">当前版本 {SITE.version}</span>
    </div>
  </div>
</section>
