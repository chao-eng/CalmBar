---
import FeatureIcon from '@/components/site/FeatureIcon.astro'
import { PROBLEMS } from '@/lib/site'
import type { FeatureIconKey } from '@/lib/features'
---

<section id="why" class="section" aria-labelledby="why-title">
  <div class="container-page">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">它解决什么</p>
      <h2 id="why-title" class="section-title">Mac 上好用的部分，系统默认都不给你</h2>
      <p class="section-desc">
        温度看不到、风扇只有一档、电池一直充到满、菜单栏图标越堆越多、卸载永远删不干净。
        这些不算大问题，但每天都会碰到一次。
      </p>
    </div>

    <div class="reveal mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        PROBLEMS.map((item) => (
          <div class="card-surface p-5">
            <FeatureIcon name={item.icon as FeatureIconKey} class="text-muted-foreground size-5" />
            <h3 class="mt-3 text-sm font-semibold">{item.title}</h3>
            <p class="text-muted-foreground mt-1.5 text-sm leading-6">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
